DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/painlab"

# LLM — get free key at console.groq.com (no credit card)
GROQ_API_KEY=your_groq_key_here
# Optional Gemini fallback — get at aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Web search — get free key at tavily.com (1000 searches/month free)
TAVILY_API_KEY=your_tavily_key_here

# Agent tuning (these defaults are fine to leave as-is)
AGENT_MAX_CANDIDATES=5
AGENT_KILL_ROUNDS=3
AGENT_SEARCH_DEPTH=10
